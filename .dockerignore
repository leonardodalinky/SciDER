# ...but re-include the mle-bench scider agent subtree, since
# benchmarks/mlebench/mle-bench/agents/scider/Dockerfile runs COPY from
# there during the agent image build. Negations must re-include every
# intermediate directory (Docker walks top-down).
!benchmarks/mlebench
!benchmarks/mlebench/mle-bench
!benchmarks/mlebench/mle-bench/agents
!benchmarks/mlebench/mle-bench/agents/scider
!benchmarks/mlebench/mle-bench/agents/scider/**
tmp_*
rsync_tmp_*
*.ipynb
